    25: 
    26: 	private static class FormatterCache&lt;T&gt;
    27: 	{
    28: 		internal static readonly MsgPack::Formatters.IMessagePackFormatter&lt;T&gt; Formatter;
    29: 
    30: 		static FormatterCache()
    31: 		{
    32: 			var f = GeneratedMessagePackResolverGetFormatterHelper.GetFormatter(typeof(T));
    33: 			if (f != null)
    34: 			{
    35: 				Formatter = (MsgPack::Formatters.IMessagePackFormatter&lt;T&gt;)f;
    36: 			}
    37: 		}
    38: 	}
    39: 
    40: 	private static class GeneratedMessagePackResolverGetFormatterHelper
    41: 	{
    42: 		private static readonly global::System.Collections.Generic.Dictionary&lt;global::System.Type, int&gt; openTypeLookup = new global::System.Collections.Generic.Dictionary&lt;global::System.Type, int&gt;(1)
    43: 		{
    44: 			{ typeof(global::GenericClass&lt;,&gt;), 0 },
    45: 		};
    46: 
    47: 		internal static object GetFormatter(global::System.Type t)
    48: 		{
    49: 			if (t.IsGenericType &amp;&amp; openTypeLookup.TryGetValue(t.GetGenericTypeDefinition(), out int openKey))
    50: 			{
    51: 				switch (openKey)
    52: 				{
    53: 					case 0: return global::System.Activator.CreateInstance(typeof(global::MessagePack.GeneratedMessagePackResolver.GenericClassFormatter&lt;,&gt;).MakeGenericType(t.GenericTypeArguments));
    54: 					default: return null; // unreachable
    55: 				};
    56: 			}
    57: 
    58: 			return null;
    59: 		}
    60: 	}
    61: }
    62: 
    63: }
