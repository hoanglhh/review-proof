    21: 	public MsgPack::Formatters.IMessagePackFormatter&lt;T&gt; GetFormatter&lt;T&gt;()
    22: 	{
    23: 		return FormatterCache&lt;T&gt;.Formatter;
    24: 	}
    25: 
    26: 	private static class FormatterCache&lt;T&gt;
    27: 	{
    28: 		internal static readonly MsgPack::Formatters.IMessagePackFormatter&lt;T&gt; Formatter;
    29: 
    30: 		static FormatterCache()
    31: 		{
    32: 			var f = GeneratedMessagePackResolverGetFormatterHelper.GetFormatter(typeof(T));
    33: 			if (f != null)
    34: 			{
    35: 				Formatter = (MsgPack::Formatters.IMessagePackFormatter&lt;T&gt;)f;
    36: 			}
    37: 		}
    38: 	}
    39: 
    40: 	private static class GeneratedMessagePackResolverGetFormatterHelper
    41: 	{
    42: 		private static readonly global::System.Collections.Generic.Dictionary&lt;global::System.Type, int&gt; closedTypeLookup = new global::System.Collections.Generic.Dictionary&lt;global::System.Type, int&gt;(4)
    43: 		{
    44: 			{ typeof(global::NS3.MyType&lt;int&gt;), 0 },
    45: 			{ typeof(global::NS1.MyType), 1 },
    46: 			{ typeof(global::MyMessagePackObject), 2 },
    47: 			{ typeof(global::NS2.MyType), 3 },
    48: 		};
    49: 		private static readonly global::System.Collections.Generic.Dictionary&lt;global::System.Type, int&gt; openTypeLookup = new global::System.Collections.Generic.Dictionary&lt;global::System.Type, int&gt;(1)
    50: 		{
    51: 			{ typeof(global::NS3.MyType&lt;&gt;), 0 },
    52: 		};
    53: 
    54: 		internal static object GetFormatter(global::System.Type t)
    55: 		{
    56: 			if (closedTypeLookup.TryGetValue(t, out int closedKey))
    57: 			{
    58: 				switch (closedKey)
    59: 				{
    60: 					case 0: return new global::MessagePack.GeneratedMessagePackResolver.NS3.MyTypeFormatter&lt;int&gt;();
    61: 					case 1: return new global::MessagePack.GeneratedMessagePackResolver.NS1.MyTypeFormatter();
    62: 					case 2: return new global::MessagePack.GeneratedMessagePackResolver.MyMessagePackObjectFormatter();
    63: 					case 3: return new global::MessagePack.GeneratedMessagePackResolver.NS2.MyTypeFormatter();
    64: 					default: return null; // unreachable
    65: 				};
    66: 			}
    67: 			if (t.IsGenericType &amp;&amp; openTypeLookup.TryGetValue(t.GetGenericTypeDefinition(), out int openKey))
    68: 			{
    69: 				switch (openKey)
    70: 				{
    71: 					case 0: return global::System.Activator.CreateInstance(typeof(global::MessagePack.GeneratedMessagePackResolver.NS3.MyTypeFormatter&lt;&gt;).MakeGenericType(t.GenericTypeArguments));
    72: 					default: return null; // unreachable
    73: 				};
    74: 			}
    75: 
    76: 			return null;
    77: 		}
    78: 	}
    79: }
    80: 
    81: }
